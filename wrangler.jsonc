{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "mens-datsumou-lab",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "mens-datsumou-lab-db","database_id": "8999e5ec-98cc-49c6-90c2-544d147cc404",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "mens-datsumou-lab-media","preview_bucket_name": "mens-datsumou-lab-media",
		},
	],
	// Sandboxed plugins require Worker Loader, available on Workers paid plans. Uncomment to enable:
	// "worker_loaders": [{ "binding": "LOADER" }],
	// General maintenance cron trigger
	"triggers": {
		"crons": ["* * * * *"],
	},
}
